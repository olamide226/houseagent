# Copy to .env (git-ignored) and fill in. Placeholders only: never commit real values.
DATABASE_URL=postgresql+asyncpg://ha:change-me@localhost/houseagent
PUBLIC_BASE_URL=http://localhost:8000
SESSION_SECRET=change-me-to-64-random-bytes
SETUP_TOKEN=change-me

AGENT_NAME=Home
DEFAULT_TIMEZONE=Europe/London
DEBOUNCE_SECONDS=4
LOG_LEVEL=INFO

# openai_compat (any OpenAI-compatible endpoint) or anthropic
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=change-me
LLM_MODEL=provider-model-id
LLM_SUPPORTS_IMAGES=true
LLM_MAX_TOOL_ITERATIONS=8

# Voice notes (optional): an OpenAI-compatible /audio/transcriptions endpoint
#STT_PROVIDER=openai_compat
#STT_BASE_URL=https://api.example.com/v1
#STT_API_KEY=change-me
#STT_MODEL=whisper-model-id

# Media storage for photos and voice notes: s3 (any S3-compatible bucket, private) or imgbb
# (images only; anyone holding an image's URL can view it). Unset, photos are not read.
MEDIA_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=media
S3_ACCESS_KEY=
S3_SECRET_KEY=
#S3_REGION=us-east-1
#IMGBB_API_KEY=
MEDIA_RETENTION_DAYS=90

# Telegram (enabled when the token and webhook secret are set)
TG_BOT_TOKEN=
TG_BOT_USERNAME=
TG_WEBHOOK_SECRET=

# WhatsApp Cloud API (enabled when the first four are set). See docs/channels.md.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
#WA_API_VERSION=v26.0
#WA_REMINDER_TEMPLATE=household_reminder
